# NexusAI backend. Variable names only — never commit real values.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Exact origin of the frontend. Never a wildcard. REQUIRED in production.
WEB_ORIGIN=http://localhost:5173

# Whether X-Forwarded-For may be believed, and from how far.
# Unauthenticated rate limits (registration, login) are keyed on the client IP,
# so this decides whether they can be bypassed. Fails closed.
#   false            trust nothing; use the socket address (default)
#   1                trust one proxy hop — the usual load-balancer case
#   10.0.0.0/8,1.2.3.4   trust only these addresses/CIDRs
#   true             trust any hop; only if the service is unreachable directly
# Behind a proxy with this left at false, every visitor shares one rate-limit
# bucket. Set to true or "trust any hop" while directly reachable and the limits
# can be defeated by a client that sets its own header.
TRUST_PROXY=false

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=nexusai

# Ed25519 PEM keypair. Generate with: pnpm backend:keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=nexusai
JWT_AUDIENCE=nexusai-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Providers. All optional: a provider without a key reports NOT_CONFIGURED, and
# `auto.available` goes false when nothing is routable. Backend-only — these are
# never sent to the browser and never appear in a contract.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Deterministic in-process adapter for development and tests.
# Config refuses to start with this true when NODE_ENV=production.
TEST_PROVIDER_ENABLED=false

# Cost and abuse controls. The backend is authoritative.
MAX_MODELS_PER_REQUEST=5
MAX_CONCURRENT_MODEL_CALLS=4
MODEL_TIMEOUT_MS=60000
SYNTHESIS_TIMEOUT_MS=90000
ORCHESTRATION_TIMEOUT_MS=150000
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_CHARS=24000
MAX_CONCURRENT_STREAMS_PER_USER=3
