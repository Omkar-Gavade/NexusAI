{
  "name": "@nexusai/frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-built-css.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:css": "node scripts/check-built-css.mjs"
  },
  "dependencies": {
    "@nexusai/contracts": "workspace:*",
    "@tanstack/react-query": "^5.62.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-router": "^7.1.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4",
    "jsdom": "^25",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.7"
  }
